{
  "name": "liarena-saas",
  "private": true,
  "version": "1.0.1",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:electron": "vite build && electron-builder",
    "preview": "vite preview",
    "format": "oxfmt"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.2",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9",
    "framer-motion": "^12.42.2",
    "jspdf": "^2.5.1",
    "lucide-react": "^1.23.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.18.1",
    "react-signature-canvas": "^1.1.0-alpha.2",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/react-signature-canvas": "^1.0.7",
    "@vitejs/plugin-react": "^6.0.0",
    "electron": "^33.0.0",
    "electron-builder": "^24.13.3",
    "oxfmt": "^0.2.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^8.0.0",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.7"
  },
  "build": {
    "appId": "com.liarena.app",
    "productName": "Liarena",
    "icon": "public/logo.png",
    "publish": [
      {
        "provider": "github",
        "owner": "konigstudiosdev-design",
        "repo": "liarena-app"
      }
    ],
    "directories": {
      "output": "release/${version}"
    },
    "files": [
      "dist",
      "dist-electron"
    ],
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "public/logo.png",
      "artifactName": "${productName}-${version}-${os}.${ext}"
    },
    "win": {
      "target": "nsis",
      "icon": "public/logo.png",
      "artifactName": "${productName}-${version}-${os}.${ext}"
    }
  }
}
